# Copy to .env.local when you need one of these. Without it the dev server sends
# the backend paths to http://localhost:8000.

# Where the dev server sends the backend paths, see vite.config.ts.
# API_TARGET=http://localhost:8000

# Work on the frontend without a backend: login, logout and the current user
# are answered in the browser.
# VITE_FAKE_API=true

# Only for a backend on another hostname, without the path. Empty: the hostname
# the app runs on, through the proxy.
# VITE_API_BASEURL=
